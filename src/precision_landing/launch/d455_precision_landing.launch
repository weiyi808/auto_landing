<launch>
  <!-- Compatibility alias for the companion-controller implementation. -->
  <arg name="enable_flight" default="false"/>
  <arg name="camera_name" default="/camera/color"/>
  <arg name="image_topic" default="image_raw"/>
  <arg name="board_scale" default="1.0"/>
  <arg name="max_reprojection_error_px" default="3.0"/>

  <include file="$(find precision_landing)/launch/d455_companion_precision_landing.launch">
    <arg name="enable_flight" value="$(arg enable_flight)"/>
    <arg name="camera_name" value="$(arg camera_name)"/>
    <arg name="image_topic" value="$(arg image_topic)"/>
    <arg name="board_scale" value="$(arg board_scale)"/>
    <arg name="max_reprojection_error_px"
         value="$(arg max_reprojection_error_px)"/>
  </include>
</launch>
